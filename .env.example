# Threatready API configuration (apps/api). Copy to .env in the repository root or apps/api and adjust.
# Placeholder values only — never commit real secrets. Production reads these from SSM / Secrets Manager.

# development | test | production   (production: secure cookies, HSTS, no OpenAPI, email verification + staff MFA on)
THREATREADY_ENV=development
# api | worker | all
THREATREADY_ROLE=all
THREATREADY_PORT=8000

# PostgreSQL in production (postgres://user:pass@host:5432/db). Locally the embedded PGlite database is used:
#   pglite://<directory>   persistent      pglite://memory   throw-away
# THREATREADY_DATABASE_URL=pglite://apps/api/var/pgdata

# Session signing secret, 32+ characters (required in production): openssl rand -hex 32
THREATREADY_AUTH_SECRET=

# Public origin of the web app and the origins allowed to make state-changing requests.
THREATREADY_PUBLIC_URL=http://localhost:5173
THREATREADY_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional bootstrap administrator (created at start-up / by `cli migrate`). Minimum 12 characters; empty skips it.
THREATREADY_BOOTSTRAP_ADMIN_EMAIL=admin@threatready.local
THREATREADY_BOOTSTRAP_ADMIN_PASSWORD=

THREATREADY_ALLOW_SELF_REGISTRATION=true
THREATREADY_LOGIN_RATE_LIMIT_PER_MINUTE=10
THREATREADY_API_RATE_LIMIT_PER_MINUTE=600

# Where REAL_LAB artefacts (encrypted files, lab SQLite databases, backups) are written.
# THREATREADY_LAB_DATA_DIR=apps/api/var/labs

# Ports: local | s3 (stub), console | ses (stub), none | anthropic (not implemented)
THREATREADY_STORAGE_DRIVER=local
THREATREADY_MAIL_DRIVER=console
THREATREADY_LLM_DRIVER=none
# THREATREADY_SENTRY_DSN=
