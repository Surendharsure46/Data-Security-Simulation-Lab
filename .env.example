# Threatready configuration. Copy to .env (repository root or backend/) and adjust.
# Placeholder values only — never commit real secrets.

# development | production (production hides /api/docs)
THREATREADY_ENV=development

# SQLite (default, local-first). PostgreSQL is not yet supported by the migrations/tests in this release.
THREATREADY_DATABASE_URL=sqlite:///./var/threatready.db

# Where REAL_LAB artefacts (encrypted files, lab SQLite databases, backups) are written.
THREATREADY_LAB_DATA_DIR=./var/labs

# Optional bootstrap administrator created by `python -m app.cli init-db`.
# Leave the password empty to skip. Minimum 12 characters.
THREATREADY_BOOTSTRAP_ADMIN_USERNAME=admin
THREATREADY_BOOTSTRAP_ADMIN_PASSWORD=

# Allow learners to create their own accounts from the sign-in page.
THREATREADY_ALLOW_SELF_REGISTRATION=true

# Session token lifetime and login throttling.
THREATREADY_TOKEN_TTL_HOURS=12
THREATREADY_LOGIN_RATE_LIMIT_PER_MINUTE=10

# PBKDF2-SHA256 iterations for password hashing (OWASP guidance: 600000).
THREATREADY_PASSWORD_HASH_ITERATIONS=600000

# Optional AI explanations: not implemented. Keep "none". No data is sent externally.
THREATREADY_AI_PROVIDER=none
